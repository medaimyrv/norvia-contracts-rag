# Copia este archivo a .env (`cp .env.example .env`). Nunca subas .env al repositorio [S2].
# Con los valores por defecto el sistema funciona sin claves (MODEL_PROVIDER=fake).

# --- PostgreSQL + pgvector ---
POSTGRES_USER=norvia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=norvia
DATABASE_URL=postgresql+psycopg://norvia:change-me@postgres:5432/norvia

# --- Redis (broker de Celery) ---
REDIS_URL=redis://redis:6379/0

# --- Proveedor de modelos [D6] ---
# fake   -> deterministas, sin red ni claves (tests y demo)
# gemini -> LiteLLM + Gemini (requiere GEMINI_API_KEY)
MODEL_PROVIDER=fake
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
# Fijado en la migración: cambiarlo exige migración nueva y reingesta [D6]
EMBEDDING_DIM=768
LLM_TIMEOUT_S=30

# --- Recuperación y política anti-alucinación [R8, R11] ---
RETRIEVAL_K=6

# Vacío = valor calibrado para el proveedor (eval/RESULTS.md). Fíjalo solo para experimentar
RELEVANCE_THRESHOLD=

# --- Ingesta y seguridad [S1] ---
MAX_UPLOAD_MB=20
UPLOAD_DIR=/data/uploads

# --- Observabilidad [Q2, S4] ---
OTEL_SERVICE_NAME=norvia-rag
# console | otlp
OTEL_EXPORTER=console
# Con otlp: docker compose --profile observability up -> Jaeger en http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# false: preguntas y chunks no se registran en spans ni en logs
OTEL_CAPTURE_CONTENT=false
LOG_LEVEL=INFO
